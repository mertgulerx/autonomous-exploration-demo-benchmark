ARG BENCHMARK_BASE=autonomous-exploration-benchmark:jazzy-harmonic
FROM ${BENCHMARK_BASE}
LABEL org.benchmark.suite="1"
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3.12-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv --system-site-packages /opt/benchmark-suite-env
COPY suite/requirements-engine.lock /opt/benchmark-suite/requirements-engine.lock
RUN /opt/benchmark-suite-env/bin/pip install --no-cache-dir -r /opt/benchmark-suite/requirements-engine.lock
# Telemetry and insight build as Release like the runtime workspace (B3, 26 October 2026; no build type before
# suite image version 50).
COPY exploration_benchmark_telemetry /opt/benchmark-telemetry/source/exploration_benchmark_telemetry
RUN /bin/bash -c 'source /opt/ros/jazzy/setup.bash && \
    CMAKE_BUILD_PARALLEL_LEVEL=2 colcon --log-base /opt/benchmark-telemetry/log build \
    --base-paths /opt/benchmark-telemetry/source --build-base /opt/benchmark-telemetry/build \
    --install-base /opt/benchmark-telemetry/install --executor sequential \
    --cmake-args -DBUILD_TESTING=OFF -DCMAKE_BUILD_TYPE=Release -DPython3_EXECUTABLE=/usr/bin/python3'
# The insight node compiles the explorer's debug analysis from the base image's explorer source, so it
# analyses with exactly the explorer the workers run (the engine hashes that source for provenance).
ENV BENCHMARK_EXPLORER_SOURCE=/opt/benchmark_ws/exploration_packages/frontier_exploration_ros2
COPY exploration_benchmark_insight /opt/benchmark-insight/source/exploration_benchmark_insight
RUN /bin/bash -c 'source /opt/ros/jazzy/setup.bash && source /opt/benchmark_ws/install/setup.bash && \
    CMAKE_BUILD_PARALLEL_LEVEL=2 colcon --log-base /opt/benchmark-insight/log build \
    --base-paths /opt/benchmark-insight/source --build-base /opt/benchmark-insight/build \
    --install-base /opt/benchmark-insight/install --executor sequential \
    --cmake-args -DBUILD_TESTING=OFF -DCMAKE_BUILD_TYPE=Release -DPython3_EXECUTABLE=/usr/bin/python3 \
    -DFRONTIER_EXPLORATION_SOURCE_DIR="$BENCHMARK_EXPLORER_SOURCE"'
COPY suite /opt/benchmark-suite/source
COPY exploration_benchmark_runner/exploration_benchmark_runner /opt/benchmark-suite/plugins/runner/exploration_benchmark_runner
COPY exploration_benchmark_robots/exploration_benchmark_robots /opt/benchmark-suite/plugins/robots/exploration_benchmark_robots
RUN /opt/benchmark-suite-env/bin/pip install --no-deps /opt/benchmark-suite/source \
    && cp -a /root/.gz/fuel /opt/benchmark-fuel \
    && chmod -R a+rX /opt/benchmark-fuel \
    && install -d -m 1777 /tmp/benchmark-suite-runtime \
    && mkdir -p /usr/share/glvnd/egl_vendor.d \
    && printf '%s\n' '{"file_format_version":"1.0.0","ICD":{"library_path":"libEGL_nvidia.so.0"}}' \
       > /usr/share/glvnd/egl_vendor.d/10_nvidia.json
COPY docker/suite_entrypoint.sh /opt/benchmark-suite/entrypoint.sh
ENV BENCHMARK_TELEMETRY_INSTALL=/opt/benchmark-telemetry/install \
    BENCHMARK_INSIGHT_INSTALL=/opt/benchmark-insight/install \
    GZ_FUEL_CACHE_PATH=/opt/benchmark-fuel \
    BENCHMARK_FUEL_CACHE=/opt/benchmark-fuel \
    OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 \
    MPLBACKEND=Agg PYTHONUNBUFFERED=1
ENTRYPOINT ["/bin/bash", "/opt/benchmark-suite/entrypoint.sh"]
