 using namespace exploration;
 using std::placeholders::_1;
 
+// Bounds check (benchmark build patch): a grid index outside the grid reads as unknown (-1), as an occupancy
+// grid treats the space beyond its extent; in-range reads are unchanged.
+static int cellOrUnknown(const nav_msgs::msg::OccupancyGrid & grid, double index)
+{
+    if (!std::isfinite(index) || index < 0.0 || index >= static_cast<double>(grid.data.size())) {
+        return -1;
+    }
+    return grid.data[static_cast<size_t>(index)];
+}
