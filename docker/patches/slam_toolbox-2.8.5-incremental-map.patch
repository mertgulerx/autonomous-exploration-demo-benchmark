+/**
+ * Benchmark incremental-map patch: an occupancy grid on a fixed lattice that adds only new scans
+ * to its hit and pass counts. A world coordinate v falls in lattice cell Round(v / resolution),
+ * so lattice cell k is centred on k * resolution whatever the grid's extent. The grid holds the
+ * lattice cells of its scans' bounding boxes, and its offset is the centre of its first cell
+ * (Karto's convention). Hit and pass counts are sums over scans, independent of the extent: growing
+ * the grid copies them to their new place, and adding the new scans gives the same counts, and the
+ * same cells, as building the grid from every scan. That holds only while added scans never move
+ * (no scan matching, no loop closure).
+ */
+class IncrementalOccupancyGrid : public OccupancyGrid
+{
+public:
+  explicit IncrementalOccupancyGrid(kt_double resolution)
+  : OccupancyGrid(0, 0, Vector2<kt_double>(), resolution),
+    m_Scale(1.0 / resolution),
+    m_MinX(0),
+    m_MinY(0),
+    m_Empty(true)
+  {
+  }
+
+  /**
+   * Adds the scans from index first on, growing the grid to hold them, and recomputes every cell.
+   * @return whether the grid grew
+   */
+  kt_bool AddScans(const LocalizedRangeScanVector & rScans, size_t first)
+  {
+    BoundingBox2 boundingBox;
+    kt_bool hasScans = false;
+    for (size_t i = first; i < rScans.size(); ++i) {
+      if (rScans[i] != nullptr) {
+        boundingBox.Add(rScans[i]->GetBoundingBox());
+        hasScans = true;
+      }
+    }
+    kt_bool grew = false;
+    if (hasScans) {
+      kt_int32s minX = Lattice(boundingBox.GetMinimum().GetX());
+      kt_int32s minY = Lattice(boundingBox.GetMinimum().GetY());
+      kt_int32s maxX = Lattice(boundingBox.GetMaximum().GetX());
+      kt_int32s maxY = Lattice(boundingBox.GetMaximum().GetY());
+      if (!m_Empty) {
+        minX = std::min(minX, m_MinX);
+        minY = std::min(minY, m_MinY);
+        maxX = std::max(maxX, m_MinX + GetWidth() - 1);
+        maxY = std::max(maxY, m_MinY + GetHeight() - 1);
+      }
+      grew = m_Empty || minX != m_MinX || minY != m_MinY ||
+        maxX - minX + 1 != GetWidth() || maxY - minY + 1 != GetHeight();
+      if (grew) {
+        Grow(minX, minY, maxX, maxY);
+      }
+      for (size_t i = first; i < rScans.size(); ++i) {
+        if (rScans[i] != nullptr) {
+          AddScan(rScans[i]);
+        }
+      }
+    }
+    Update();
+    return grew;
+  }
+
+protected:
+  /**
+   * OccupancyGrid::RayTrace with grid cells taken from lattice cells in integers, so that a ray
+   * covers the same lattice cells in every extent. Map building only (AddScan without doUpdate).
+   */
+  virtual kt_bool RayTrace(
+    const Vector2<kt_double> & rWorldFrom,
+    const Vector2<kt_double> & rWorldTo,
+    kt_bool isEndPointValid,
+    kt_bool doUpdate = false)
+  {
+    assert(!doUpdate);
+    (void)doUpdate;
+    Vector2<kt_int32s> gridFrom(Lattice(rWorldFrom.GetX()) - m_MinX,
+      Lattice(rWorldFrom.GetY()) - m_MinY);
+    Vector2<kt_int32s> gridTo(Lattice(rWorldTo.GetX()) - m_MinX, Lattice(rWorldTo.GetY()) - m_MinY);
+    m_pCellPassCnt->TraceLine(gridFrom.GetX(), gridFrom.GetY(), gridTo.GetX(), gridTo.GetY());
+    if (isEndPointValid && m_pCellPassCnt->IsValidGridIndex(gridTo)) {
+      kt_int32s index = m_pCellPassCnt->GridIndex(gridTo, false);
+      m_pCellPassCnt->GetDataPointer()[index]++;
+      m_pCellHitsCnt->GetDataPointer()[index]++;
+    }
+    return m_pCellPassCnt->IsValidGridIndex(gridTo);
+  }
+
+private:
+  kt_int32s Lattice(kt_double value) const
+  {
+    return static_cast<kt_int32s>(math::Round(value * m_Scale));
+  }
+
+  /**
+   * Resizes the grid to the lattice cells [minX, maxX] x [minY, maxY], which hold the current ones,
+   * and copies the hit and pass counts to their new place.
+   */
+  void Grow(kt_int32s minX, kt_int32s minY, kt_int32s maxX, kt_int32s maxY)
+  {
+    kt_int32s width = maxX - minX + 1;
+    kt_int32s height = maxY - minY + 1;
+    Vector2<kt_double> offset(minX / m_Scale, minY / m_Scale);
+    Grid<kt_int32u> * pCellPassCnt = Grid<kt_int32u>::CreateGrid(width, height, 1.0 / m_Scale);
+    Grid<kt_int32u> * pCellHitsCnt = Grid<kt_int32u>::CreateGrid(width, height, 1.0 / m_Scale);
+    if (!m_Empty) {
+      CopyCounts(m_pCellPassCnt, pCellPassCnt, m_MinX - minX, m_MinY - minY);
+      CopyCounts(m_pCellHitsCnt, pCellHitsCnt, m_MinX - minX, m_MinY - minY);
+    }
+    pCellPassCnt->GetCoordinateConverter()->SetOffset(offset);
+    pCellHitsCnt->GetCoordinateConverter()->SetOffset(offset);
+    delete m_pCellPassCnt;
+    delete m_pCellHitsCnt;
+    m_pCellPassCnt = pCellPassCnt;
+    m_pCellHitsCnt = pCellHitsCnt;
+    Grid<kt_int8u>::Resize(width, height);
+    GetCoordinateConverter()->SetOffset(offset);
+    m_MinX = minX;
+    m_MinY = minY;
+    m_Empty = false;
+  }
+
+  static void CopyCounts(
+    Grid<kt_int32u> * pFrom, Grid<kt_int32u> * pTo, kt_int32s shiftX, kt_int32s shiftY)
+  {
+    for (kt_int32s y = 0; y < pFrom->GetHeight(); ++y) {
+      memcpy(
+        pTo->GetDataPointer() + (y + shiftY) * pTo->GetWidthStep() + shiftX,
+        pFrom->GetDataPointer() + y * pFrom->GetWidthStep(),
+        pFrom->GetWidth() * sizeof(kt_int32u));
+    }
+  }
+
+  kt_double m_Scale;
+  kt_int32s m_MinX;  // lattice cell of the grid's first column
+  kt_int32s m_MinY;  // lattice cell of the grid's first row
+  kt_bool m_Empty;
+};    // IncrementalOccupancyGrid
+
