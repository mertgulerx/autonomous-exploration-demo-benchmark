# Refresh application code on an already-built vendor image. Use Dockerfile for
# a clean dependency build. Set BENCHMARK_BASE to an existing dependency image.
ARG BENCHMARK_BASE
FROM ${BENCHMARK_BASE}
LABEL org.benchmark.multi_robot="1"
# C++ build type of the refreshed packages (B3; the build step below checks each of them). Packages of the base
# that the refresh does not rebuild keep the base's build type until the next full build (docker/Dockerfile).
LABEL org.benchmark.build-type="Release (refreshed packages)"
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-laser-filters=2.0.10-5noble.20260915.190358 \
    ros-jazzy-turtlebot3-description=2.3.6-1noble.20260911.051522 \
    ros-jazzy-rviz-imu-plugin=2.1.6-1noble.20260921.024449 \
    ros-jazzy-pcl-ros=2.6.5-1noble.20260916.065720 \
    && rm -rf /var/lib/apt/lists/*
# Remove obsolete vendor SDKs and prior Python installations before copying
# the current sources; Docker COPY alone would keep deleted adapter files.
RUN rm -rf /opt/vendor/go2 /opt/vendor/ugv \
    /opt/benchmark_ws/exploration_benchmark_robots \
    /opt/benchmark_ws/exploration_benchmark_runner \
    /opt/benchmark_ws/build/exploration_benchmark_robots \
    /opt/benchmark_ws/build/exploration_benchmark_runner \
    /opt/benchmark_ws/install/exploration_benchmark_robots \
    /opt/benchmark_ws/install/exploration_benchmark_runner \
    /opt/benchmark_ws/config \
    /opt/benchmark_ws/docs \
    /opt/benchmark_ws/AGENTS.md
# Remove tests and previously installed probes from the cached base image.
RUN rm -rf /opt/benchmark_ws/rviz/test && \
    find /opt/benchmark_ws/build /opt/benchmark_ws/install \
      -depth \( -name 'test_*' -o -name test_results -o -name Testing \
      -o -name CTestTestfile.cmake -o -name comparison_probe \
      -o -name parameter_editor_probe -o -name single_run_panel_probe \) \
      -exec rm -rf {} +
COPY exploration_benchmark_robots /opt/benchmark_ws/exploration_benchmark_robots
COPY exploration_benchmark_runner /opt/benchmark_ws/exploration_benchmark_runner
COPY exploration_benchmark_interfaces /opt/benchmark_ws/exploration_benchmark_interfaces
COPY config /opt/benchmark_ws/config
COPY rviz /opt/benchmark_ws/rviz
# The explorer's full sources (refreshed since 25 October 2026, so an explorer change needs no full build);
# its test directories stay out of the image as in the full build.
RUN rm -rf /opt/benchmark_ws/exploration_packages/frontier_exploration_ros2
COPY exploration_packages/frontier_exploration_ros2 /opt/benchmark_ws/exploration_packages/frontier_exploration_ros2
RUN rm -rf /opt/benchmark_ws/exploration_packages/frontier_exploration_ros2/test \
    /opt/benchmark_ws/exploration_packages/frontier_exploration_ros2/plugin/frontier_exploration_ros2_rviz/test
COPY simulation/Week-7-8-ROS2-Navigation/bme_ros2_navigation/CMakeLists.txt /opt/benchmark_ws/simulation/Week-7-8-ROS2-Navigation/bme_ros2_navigation/CMakeLists.txt
COPY simulation/Week-7-8-ROS2-Navigation/bme_ros2_navigation/package.xml /opt/benchmark_ws/simulation/Week-7-8-ROS2-Navigation/bme_ros2_navigation/package.xml
COPY simulation/Week-7-8-ROS2-Navigation/bme_ros2_navigation_py/setup.py simulation/Week-7-8-ROS2-Navigation/bme_ros2_navigation_py/package.xml /opt/benchmark_ws/simulation/Week-7-8-ROS2-Navigation/bme_ros2_navigation_py/
COPY simulation/Week-7-8-ROS2-Navigation/bme_ros2_navigation/launch /opt/benchmark_ws/simulation/Week-7-8-ROS2-Navigation/bme_ros2_navigation/launch
COPY simulation/Week-7-8-ROS2-Navigation/bme_ros2_navigation/rviz /opt/benchmark_ws/simulation/Week-7-8-ROS2-Navigation/bme_ros2_navigation/rviz
# Registry worlds kept under simulation/worlds that bases built before them lack (the FIT-SLAM corridor), and
# the Warehouse world changed after the base (barrier row closed, 25 October 2026).
COPY simulation/worlds/fitslam_corridor /opt/benchmark_ws/simulation/worlds/fitslam_corridor
COPY simulation/worlds/warehouse /opt/benchmark_ws/simulation/worlds/warehouse
COPY launch.sh docker.sh /opt/benchmark_ws/
COPY docker/entrypoint.sh /opt/benchmark_ws/docker/entrypoint.sh
COPY docker/Dockerfile docker/Dockerfile.runtime docker/build_robot_dependencies.sh docker/fetch_slam_toolbox.sh docker/fetch_external_explorers.sh /opt/benchmark_ws/docker/
COPY docker/patches /opt/benchmark_ws/docker/patches
# SLAM Toolbox 2.8.5 with the grid-extent patch and the external explorers at their pinned commits
# (Dockerfile has the same step; pcl_ros is pinned in the apt step above).
RUN bash /opt/benchmark_ws/docker/fetch_slam_toolbox.sh /opt/benchmark_ws/vendor_src && \
    bash /opt/benchmark_ws/docker/fetch_external_explorers.sh /opt/benchmark_ws/vendor_src
COPY README.md /opt/benchmark_ws/README.md
# The refreshed packages, built as Release (B3, 26 October 2026; the images had no build type before runtime
# version 14); the check after the build requires each one installed and each CMake one configured as Release.
RUN /bin/bash -c "source /opt/ros/jazzy/setup.bash && source install/setup.bash && \
    packages='exploration_benchmark_interfaces frontier_exploration_ros2 bme_ros2_navigation bme_ros2_navigation_py \
      exploration_benchmark_robots exploration_benchmark_runner rviz_autonomous_exploration_benchmark slam_toolbox \
      explore_lite_msgs explore_lite roadmap_explorer_msgs roadmap_explorer rrt_explore tdle mrtsp_exploration_ros2' && \
    CMAKE_BUILD_PARALLEL_LEVEL=2 \
    colcon build --symlink-install --executor sequential --packages-select \${packages} \
    --cmake-args -DBUILD_TESTING=OFF -DCMAKE_BUILD_TYPE=Release && \
    for package in \${packages}; do \
      test -f install/\${package}/share/\${package}/package.xml || { echo not installed: \${package}; exit 1; }; \
      cache=build/\${package}/CMakeCache.txt; \
      if [ -f \${cache} ]; then grep -qx CMAKE_BUILD_TYPE:STRING=Release \${cache} || { echo not Release: \${package}; exit 1; }; fi; \
    done"
# Mark the patched SLAM Toolbox build with its patch hash; the worker refuses any other build
# (mapping-known-pose-v3, plans/worlds/I10).
RUN cd /opt/benchmark_ws && sha256sum docker/patches/slam_toolbox-2.8.5-grid-extent.patch | cut -d' ' -f1 \
    > install/slam_toolbox/share/slam_toolbox/benchmark_grid_extent.sha256
# Rebuild the E0 moving-object system from the current sources (Dockerfile has the same step; the variable
# is repeated for bases built before it).
RUN rm -rf /opt/benchmark_ws/world_collection/plugins/moving_objects /opt/benchmark-moving-objects
COPY world_collection/plugins/moving_objects /opt/benchmark_ws/world_collection/plugins/moving_objects
RUN /bin/bash -c "source /opt/ros/jazzy/setup.bash && \
    cmake -S /opt/benchmark_ws/world_collection/plugins/moving_objects -B /opt/benchmark-moving-objects/build \
    -DMOVING_OBJECTS_LIB_DIR=/opt/benchmark-moving-objects/lib && \
    CMAKE_BUILD_PARALLEL_LEVEL=2 cmake --build /opt/benchmark-moving-objects/build && \
    cmake --install /opt/benchmark-moving-objects/build && \
    rm -rf /opt/benchmark-moving-objects/build"
ENV GZ_SIM_SYSTEM_PLUGIN_PATH=/opt/benchmark-moving-objects/lib
