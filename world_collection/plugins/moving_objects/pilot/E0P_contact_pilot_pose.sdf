<?xml version="1.0" encoding="utf-8"?>
<!--
  Design ledger
  Document: E0P_contact_pilot_pose.sdf, SDF 1.9, world `E0P` (E0 contact pilot).
  Consumer: Gazebo Harmonic (gz-sim 8, sdformat14). Units: SI (metres, radians).
  Frames: x east, y north, z up; world origin as in the plan. Every pose is written out and uses SDF's
    default frame (model: world; link: model; collision and visual: link). Models and links sit at
    their parent origins, so every primitive pose is also its world pose. No relative_to attribute is
    used: Gazebo skips serialising models that carry one.
  Names: each primitive gives a collision `<name>_col` and a visual `<name>_vis` (unique siblings).
  Generator: worldgen 1.0.1; plan docs/plans/worlds/E0-moving-object-system.md.
  Parameters: none. Seed: none.
  Sources: none.
  Header: copied from simulation/worlds/corridor/corridor.world (SHA-256 2b52a0ad88202c2f2b72f39a9101340ae9b9443c4245356c7a2c6ea11a5c07de).
  Floor: a static box 0.05 m thick with its top face at z = 0 (as the Corridor floor).
  Primitives by role: boundary wall: 4. Collision and visual geometry are identical.
  Moving objects (E0, docs/plans/worlds/E0-moving-object-system.md):
    3 non-static models mo_00..mo_02; density none, seed 0, velocity mode pose;
    moved by the benchmark::MovingObjects system plugin (benchmark-moving-objects-system).
-->
<sdf version="1.9">
  <world name="e0p_contact_pilot_pose">
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <physics name="default_physics" default="1" type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>200</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- E0 moving-object system; plan docs/plans/worlds/E0-moving-object-system.md; values written by worldgen -->
    <plugin filename="benchmark-moving-objects-system" name="benchmark::MovingObjects">
      <format_version>1</format_version>
      <topic>/benchmark/moving_objects/pose</topic>
      <publish_period_ms>50</publish_period_ms>
      <velocity_mode>pose</velocity_mode>
      <turn_rate>1.000000</turn_rate>
      <seed>0</seed>
      <object>
        <model>mo_00</model>
        <mode>patrol</mode>
        <speed>0.30</speed>
        <phase_ns>0</phase_ns>
        <cycle_ns>62000000000</cycle_ns>
        <yaw_mode>heading</yaw_mode>
        <yaw>0.000000</yaw>
        <z>0.6100</z>
        <waypoint x="1.0000" y="2.5000" dwell="30.000"/>
        <waypoint x="1.3000" y="2.5000" dwell="30.000"/>
      </object>
      <object>
        <model>mo_01</model>
        <mode>patrol</mode>
        <speed>0.50</speed>
        <phase_ns>0</phase_ns>
        <cycle_ns>22800000000</cycle_ns>
        <yaw_mode>fixed</yaw_mode>
        <yaw>0.000000</yaw>
        <z>0.6100</z>
        <waypoint x="2.0000" y="-1.2000" dwell="1.000"/>
        <waypoint x="2.0000" y="4.0000" dwell="1.000"/>
      </object>
      <object>
        <model>mo_02</model>
        <mode>patrol</mode>
        <speed>0.50</speed>
        <phase_ns>0</phase_ns>
        <cycle_ns>36000000000</cycle_ns>
        <yaw_mode>heading</yaw_mode>
        <yaw>0.000000</yaw>
        <z>0.5100</z>
        <waypoint x="-3.0000" y="-2.5000" dwell="2.000"/>
        <waypoint x="5.0000" y="-2.5000" dwell="2.000"/>
      </object>
    </plugin>

    <scene>
      <ambient>0.72 0.72 0.72 1</ambient>
      <background>0.95 0.95 0.95 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="ground_link">
        <pose>0.0000 0.0000 -0.0250 0 0 0</pose>
        <collision name="ground_collision">
          <geometry><box><size>20.4000 14.4000 0.0500</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="ground_visual">
          <geometry><box><size>20.4000 14.4000 0.0500</size></box></geometry>
          <material><ambient>0.86 0.86 0.84 1</ambient><diffuse>0.86 0.86 0.84 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="E0P_structure">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="structure_link">
        <pose>0 0 0 0 0 0</pose>
        <collision name="outer_e_00_col">
          <pose>8.1000 0.0000 1.0000 0 0 0.000000</pose>
          <geometry><box><size>0.2000 10.0000 2.0000</size></box></geometry>
        </collision>
        <visual name="outer_e_00_vis">
          <pose>8.1000 0.0000 1.0000 0 0 0.000000</pose>
          <geometry><box><size>0.2000 10.0000 2.0000</size></box></geometry>
          <material>
            <ambient>0.62 0.62 0.62 1</ambient>
            <diffuse>0.62 0.62 0.62 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="outer_n_00_col">
          <pose>0.0000 5.1000 1.0000 0 0 0.000000</pose>
          <geometry><box><size>16.4000 0.2000 2.0000</size></box></geometry>
        </collision>
        <visual name="outer_n_00_vis">
          <pose>0.0000 5.1000 1.0000 0 0 0.000000</pose>
          <geometry><box><size>16.4000 0.2000 2.0000</size></box></geometry>
          <material>
            <ambient>0.62 0.62 0.62 1</ambient>
            <diffuse>0.62 0.62 0.62 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="outer_s_00_col">
          <pose>0.0000 -5.1000 1.0000 0 0 0.000000</pose>
          <geometry><box><size>16.4000 0.2000 2.0000</size></box></geometry>
        </collision>
        <visual name="outer_s_00_vis">
          <pose>0.0000 -5.1000 1.0000 0 0 0.000000</pose>
          <geometry><box><size>16.4000 0.2000 2.0000</size></box></geometry>
          <material>
            <ambient>0.62 0.62 0.62 1</ambient>
            <diffuse>0.62 0.62 0.62 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="outer_w_00_col">
          <pose>-8.1000 0.0000 1.0000 0 0 0.000000</pose>
          <geometry><box><size>0.2000 10.0000 2.0000</size></box></geometry>
        </collision>
        <visual name="outer_w_00_vis">
          <pose>-8.1000 0.0000 1.0000 0 0 0.000000</pose>
          <geometry><box><size>0.2000 10.0000 2.0000</size></box></geometry>
          <material>
            <ambient>0.62 0.62 0.62 1</ambient>
            <diffuse>0.62 0.62 0.62 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="mo_00">
      <static>false</static>
      <pose>1.0000 2.5000 0.6100 0 0 0.000000</pose>
      <link name="body">
        <gravity>false</gravity>
        <inertial>
          <mass>60.000</mass>
          <inertia><ixx>9.000000</ixx><ixy>0</ixy><ixz>0</ixz><iyy>9.000000</iyy><iyz>0</iyz><izz>3.600000</izz></inertia>
        </inertial>
        <collision name="body_col">
          <geometry><box><size>0.6000 0.6000 1.2000</size></box></geometry>
        </collision>
        <visual name="body_vis">
          <geometry><box><size>0.6000 0.6000 1.2000</size></box></geometry>
          <material><ambient>0.95 0.55 0.15 1</ambient><diffuse>0.95 0.55 0.15 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="mo_01">
      <static>false</static>
      <pose>2.0000 -1.2000 0.6100 0 0 0.000000</pose>
      <link name="body">
        <gravity>false</gravity>
        <inertial>
          <mass>40.000</mass>
          <inertia><ixx>5.425000</ixx><ixy>0</ixy><ixz>0</ixz><iyy>5.425000</iyy><iyz>0</iyz><izz>1.250000</izz></inertia>
        </inertial>
        <collision name="body_col">
          <geometry><cylinder><radius>0.2500</radius><length>1.2000</length></cylinder></geometry>
        </collision>
        <visual name="body_vis">
          <geometry><cylinder><radius>0.2500</radius><length>1.2000</length></cylinder></geometry>
          <material><ambient>0.95 0.55 0.15 1</ambient><diffuse>0.95 0.55 0.15 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="mo_02">
      <static>false</static>
      <pose>-3.0000 -2.5000 0.5100 0 0 0.000000</pose>
      <link name="body">
        <gravity>false</gravity>
        <inertial>
          <mass>80.000</mass>
          <inertia><ixx>9.066667</ixx><ixy>0</ixy><ixz>0</ixz><iyy>16.266667</iyy><iyz>0</iyz><izz>12.000000</izz></inertia>
        </inertial>
        <collision name="body_col">
          <geometry><box><size>1.2000 0.6000 1.0000</size></box></geometry>
        </collision>
        <visual name="body_vis">
          <geometry><box><size>1.2000 0.6000 1.0000</size></box></geometry>
          <material><ambient>0.95 0.55 0.15 1</ambient><diffuse>0.95 0.55 0.15 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
